# ============================================================================
# Firebase Cloud Functions (Remote MCP Server) Local Dev Environment Template
# ============================================================================
# For local emulator testing, copy to `functions/.env.local` (gitignored).
# In production, secrets are stored in Google Cloud Secret Manager via:
#   firebase functions:secrets:set <SECRET_NAME>

# WorkOS AuthKit Credentials
WORKOS_API_KEY="your-workos-secret-api-key"
WORKOS_CLIENT_ID="your-workos-client-id"
# Your WorkOS AuthKit domain (from WorkOS Dashboard -> Authentication -> AuthKit / Domains)
WORKOS_AUTHKIT_DOMAIN="https://your-project.authkit.app"

# Comma-separated list of owner email addresses (or WorkOS user_... IDs) allowed to query the MCP server
ALLOWED_USER_EMAILS="owner@example.com"

# Optional high-entropy fallback Bearer token for CLI / local MCP Inspector tests
MCP_BEARER_FALLBACK_SECRET="your-random-32-byte-hex-secret"

# Optional comma-separated extra browser origins allowed for `/api/*` CORS
# (same-origin Firebase Hosting and localhost/127.0.0.1 are always allowed automatically)
# ALLOWED_DASHBOARD_ORIGINS="https://your-custom-dashboard.example.com"
