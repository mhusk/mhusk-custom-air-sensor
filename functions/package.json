{
  "name": "custom-air-sensor-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions (2nd Gen) TypeScript backend and Remote MCP Server for the Custom ESP32-S3 Air Quality Sensor",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "verify:firestore": "npm run build && node lib/scripts/verifyFirestore.js",
    "verify:mcp": "npm run build && node lib/scripts/verifyMcp.js",
    "verify:auth": "npm run build && node lib/scripts/verifyAuth.js",
    "verify:api": "npm run build && node lib/scripts/verifyApi.js",
    "verify:release": "npm run build && node lib/scripts/verifyRelease.js",
    "publish:release": "npm run build && node lib/scripts/publishRelease.js",
    "mcp:local": "npm run build && node lib/scripts/localMcpServer.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@workos-inc/node": "^12.4.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
