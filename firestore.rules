rules_version = '2';

// Public-repo rules: no device UIDs, project IDs, or secrets are hardcoded here.
// The Firebase Console (Admin/IAM) creates authorized_devices/{uid}.
// Client SDKs and the Firestore REST API cannot read or write that collection.
// Optional per-device UID isolation (Phase 4B multi-room fleet):
//   - authorized_devices/{uid}.device_id (optional string): when set (non-null),
//     binds that Auth UID strictly to the matching device_id across readings,
//     devices/{deviceId}, and device_configs/{deviceId}.
//   - When omitted or null (legacy single-sensor allowlist doc), any valid
//     device_id is permitted for zero-downtime migration until migrated.
// SCD-40-only satellites may publish null PM/AQI/particle fields. Present
// numbers and AQI categories still have to pass the same range and enum checks.
// Authenticated allowlisted sensors may only:
//   - create immutable documents in readings/{readingId}
//   - create/update their status document in devices/{deviceId}
//   - get (single-doc read, no list/write) their config in device_configs/{deviceId}
//   - get (single-doc read, no list/write) OTA release manifests in firmware_releases/{version}
//     and non-bootloader .py payloads in firmware_releases/{version}/files/{fileId}
// Cloud Functions using the Admin SDK bypass these rules entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSensorDevice() {
      return request.auth != null
        && exists(/databases/$(database)/documents/authorized_devices/$(request.auth.uid));
    }

    function authDeviceMatches(authData, deviceId) {
      return !('device_id' in authData)
        || authData.device_id == null
        || (authData.device_id is string && authData.device_id == deviceId);
    }

    function canActAsDevice(deviceId) {
      return isSensorDevice()
        && isDeviceId(deviceId)
        && authDeviceMatches(
          get(/databases/$(database)/documents/authorized_devices/$(request.auth.uid)).data,
          deviceId
        );
    }

    function isDeviceId(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 64
        && value.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$');
    }

    function isLocation(value) {
      return isDeviceId(value);
    }

    function isSafeDocId(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 700
        && value.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,699}$');
    }

    // Timestamp type only, so a wrong or stale board clock cannot backdate history.
    // 15 minutes of lateness covers the 5-minute sample interval plus retries.
    // 5 minutes of lead covers clock skew after NTP sync.
    function isFreshTimestamp(value) {
      return value is timestamp
        && value >= request.time - duration.value(15, 'm')
        && value <= request.time + duration.value(5, 'm');
    }

    function inRange(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function intInRange(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isAqiCategory(value) {
      return value in [
        'Good',
        'Moderate',
        'Unhealthy for Sensitive Groups',
        'Unhealthy',
        'Very Unhealthy',
        'Hazardous'
      ];
    }

    // SCD-40-only satellites publish null for fields they cannot measure.
    // A present value still has to pass the same numeric or enum check.
    function nullableInRange(value, min, max) {
      return value == null || inRange(value, min, max);
    }

    function nullableAqiCategory(value) {
      return value == null || isAqiCategory(value);
    }

    // Admin-written room metadata on device_configs. Null means "unset".
    function isFloor(value) {
      return value == null
        || (value is string
          && value.size() >= 1
          && value.size() <= 32
          && value.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$'));
    }

    function isFirmwareVersion(value) {
      return value is string
        && value.size() >= 5
        && value.size() <= 32
        && value.matches('^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9.-]{0,19})?$');
    }

    function isOtaFilename(value) {
      return value is string
        && value.size() >= 4
        && value.size() <= 35
        && value.matches('^[a-z][a-z0-9_]{0,31}\\.py$')
        && !(value in ['boot.py', 'code.py']);
    }

    function isOtaStatus(value) {
      return value is string
        && value in ['up_to_date', 'updating', 'rolled_back', 'error'];
    }

    function validSensors(value) {
      return value == ['SCD-40'] || value == ['SCD-40', 'PMSA003I'];
    }

    function validLatestReading(data) {
      return data is map
        && data.keys().hasAll([
          'co2_ppm',
          'temperature_f',
          'humidity_percent',
          'pm2_5_ug_m3',
          'aqi_us',
          'aqi_category'
        ])
        && data.keys().hasOnly([
          'co2_ppm',
          'temperature_f',
          'humidity_percent',
          'pm2_5_ug_m3',
          'aqi_us',
          'aqi_category'
        ])
        && inRange(data.co2_ppm, 0, 40000)
        && inRange(data.temperature_f, -40, 185)
        && inRange(data.humidity_percent, 0, 100)
        && nullableInRange(data.pm2_5_ug_m3, 0, 1000)
        && nullableInRange(data.aqi_us, 0, 500)
        && nullableAqiCategory(data.aqi_category);
    }

    function validReading(data) {
      return data is map
        && data.keys().hasAll([
          'device_id',
          'location',
          'timestamp',
          'co2_ppm',
          'temperature_c',
          'temperature_f',
          'humidity_percent',
          'pm1_0_ug_m3',
          'pm2_5_ug_m3',
          'pm10_0_ug_m3',
          'aqi_us',
          'aqi_category',
          'particles_0_3um',
          'particles_0_5um',
          'particles_1_0um',
          'particles_2_5um',
          'particles_5_0um',
          'particles_10_0um'
        ])
        && data.keys().hasOnly([
          'device_id',
          'location',
          'timestamp',
          'co2_ppm',
          'temperature_c',
          'temperature_f',
          'humidity_percent',
          'pm1_0_ug_m3',
          'pm2_5_ug_m3',
          'pm10_0_ug_m3',
          'aqi_us',
          'aqi_category',
          'particles_0_3um',
          'particles_0_5um',
          'particles_1_0um',
          'particles_2_5um',
          'particles_5_0um',
          'particles_10_0um'
        ])
        && isDeviceId(data.device_id)
        && isLocation(data.location)
        && isFreshTimestamp(data.timestamp)
        && inRange(data.co2_ppm, 0, 40000)
        && inRange(data.temperature_c, -40, 85)
        && inRange(data.temperature_f, -40, 185)
        && inRange(data.humidity_percent, 0, 100)
        && nullableInRange(data.pm1_0_ug_m3, 0, 1000)
        && nullableInRange(data.pm2_5_ug_m3, 0, 1000)
        && nullableInRange(data.pm10_0_ug_m3, 0, 1000)
        && nullableInRange(data.aqi_us, 0, 500)
        && nullableAqiCategory(data.aqi_category)
        && nullableInRange(data.particles_0_3um, 0, 65535)
        && nullableInRange(data.particles_0_5um, 0, 65535)
        && nullableInRange(data.particles_1_0um, 0, 65535)
        && nullableInRange(data.particles_2_5um, 0, 65535)
        && nullableInRange(data.particles_5_0um, 0, 65535)
        && nullableInRange(data.particles_10_0um, 0, 65535);
    }

    function validDevice(data) {
      return data is map
        && data.keys().hasAll([
          'device_id',
          'location',
          'last_seen_at',
          'firmware_version',
          'sensors',
          'reporting_interval_seconds',
          'latest_reading'
        ])
        && data.keys().hasOnly([
          'device_id',
          'location',
          'last_seen_at',
          'firmware_version',
          'sensors',
          'reporting_interval_seconds',
          'latest_reading',
          'config_version',
          'temperature_offset_c',
          'altitude_m',
          'led_enabled',
          'ota_status',
          'ota_target_version',
          'ota_last_error'
        ])
        && isDeviceId(data.device_id)
        && isLocation(data.location)
        && isFreshTimestamp(data.last_seen_at)
        && isFirmwareVersion(data.firmware_version)
        && validSensors(data.sensors)
        && inRange(data.reporting_interval_seconds, 60, 3600)
        && validLatestReading(data.latest_reading)
        && (!('config_version' in data) || intInRange(data.config_version, 0, 1000000))
        && (!('temperature_offset_c' in data) || inRange(data.temperature_offset_c, 0, 20))
        && (!('altitude_m' in data) || inRange(data.altitude_m, 0, 5000))
        && (!('led_enabled' in data) || data.led_enabled is bool)
        && (!('ota_status' in data) || isOtaStatus(data.ota_status))
        && (!('ota_target_version' in data) || data.ota_target_version == null || isFirmwareVersion(data.ota_target_version))
        && (!('ota_last_error' in data) || data.ota_last_error == null || (data.ota_last_error is string && data.ota_last_error.size() <= 200));
    }

    match /readings/{readingId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if 'device_id' in request.resource.data
        && isDeviceId(request.resource.data.device_id)
        && canActAsDevice(request.resource.data.device_id)
        && isSafeDocId(readingId)
        && validReading(request.resource.data);
    }

    match /devices/{deviceId} {
      allow read: if false;
      allow delete: if false;
      allow create, update: if canActAsDevice(deviceId)
        && isDeviceId(deviceId)
        && request.resource.data.device_id == deviceId
        && validDevice(request.resource.data);
    }

    // Remote device configuration (control plane).
    // Allowlisted sensors may fetch a single config document by device ID,
    // but cannot list/enumerate configs or modify them.
    // Only Firebase Console (Admin/IAM) or Cloud Functions (Admin SDK) write here.
    // Optional admin-written `floor` (slug or null, max 32 chars) may be stored
    // here. Clients still cannot write this collection. A malformed floor
    // fails closed on get so a bad admin write cannot be treated as valid.
    match /device_configs/{deviceId} {
      allow get: if canActAsDevice(deviceId)
        && isDeviceId(deviceId)
        && (!('floor' in resource.data) || isFloor(resource.data.floor));
      allow list: if false;
      allow write: if false;
    }

    // Cloud pull-based OTA release manifests and Python module payloads.
    // Allowlisted sensors may fetch a single release manifest by valid SemVer
    // version and individual non-bootloader .py payloads by filename, but
    // cannot list/enumerate releases or files and cannot modify them.
    // Only Admin SDK or Firebase Console may publish releases.
    match /firmware_releases/{version} {
      allow get: if isSensorDevice() && isFirmwareVersion(version);
      allow list: if false;
      allow write: if false;

      match /files/{fileId} {
        allow get: if isSensorDevice()
          && isFirmwareVersion(version)
          && isOtaFilename(fileId);
        allow list: if false;
        allow write: if false;
      }
    }

    // Existence of authorized_devices/{auth.uid} is the allowlist.
    // Clients cannot create, read, or edit these documents.
    match /authorized_devices/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
