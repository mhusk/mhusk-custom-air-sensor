# ============================================================================
# 1. Secrets, Credentials & Personal Identifiers (NEVER COMMIT)
# ============================================================================
# CircuitPython real device credentials (Wi-Fi + Firebase Auth)
firmware/settings.toml
settings.toml

# Firebase project alias mapping (contains real GCP/Firebase project ID)
.firebaserc

# Environment & secret files
.env
.env.*
!.env.example
functions/.env
functions/.env.*
!functions/.env.example
functions/.secret*

# Google Cloud / Firebase service accounts & keys
*service-account*.json
*credentials*.json
*firebase-adminsdk*.json
*.pem
*.key
*.p12

